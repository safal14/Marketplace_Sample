<h1>Marketplace</h1>

<style>
/* Page */
body {
  font-family: Arial, sans-serif;
  background: #f5f5f5;
  padding: 20px;
}

/* Buttons */
button {
  padding: 10px 15px;
  margin-right: 10px;
  border: none;
  background: #007bff;
  color: white;
  border-radius: 5px;
  cursor: pointer;
}

button:hover {
  background: #0056b3;
}

/* GRID VIEW */
.grid-view {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin-top: 20px;
}

/* LIST VIEW */
.list-view {
  display: flex;
  flex-direction: column;
  gap: 15px;
  margin-top: 20px;
}

/* Product Card */
.product-card {
  background: white;
  padding: 15px;
  border-radius: 10px;
  box-shadow: 0px 2px 5px rgba(0,0,0,0.1);
  transition: 0.3s;
}

.product-card:hover {
  transform: scale(1.02);
}

/* Product Links */
.product-card a {
  text-decoration: none;
  color: #333;
  font-weight: bold;
  font-size: 18px;
}

.product-card a:hover {
  color: #007bff;
}

/* Responsive */
@media (max-width: 768px) {
  .grid-view {
    grid-template-columns: 1fr;
  }
}
</style>

<div>
  <button onclick="setView('grid')">Grid View</button>
  <button onclick="setView('list')">List View</button>
</div>

<div id="products" class="grid-view">
  <% @products.each do |product| %>
    <div class="product-card">
      <p>
        <%= link_to product.title, product_path(product) %> - Rs <%= product.price %>
      </p>
    </div>
  <% end %>
</div>

<script>
function setView(view) {
  const container = document.getElementById("products");

  if (view === "grid") {
    container.classList.remove("list-view");
    container.classList.add("grid-view");
  } else {
    container.classList.remove("grid-view");
    container.classList.add("list-view");
  }
}
</script>